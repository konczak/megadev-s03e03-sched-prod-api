{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "comment", "record", "verify", "risks", "close"],
  "properties": {
    "decision": { "type": "string", "enum": ["build", "decline", "close", "ask", "wait"] },
    "summary": { "type": "string" },
    "comment": { "type": "string" },
    "record": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "text"],
          "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
        }
      ]
    },
    "verify": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "expect"],
          "properties": { "path": { "type": "string" }, "expect": { "type": "string" } }
        }
      ]
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "close": { "type": "boolean" }
  }
}
